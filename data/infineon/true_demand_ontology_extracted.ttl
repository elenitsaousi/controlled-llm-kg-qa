survey:10nm_to_less_than_28nm a owl:Class ;
    rdfs:label "10nm to less than 28nm" ;
    rdfs:subClassOf survey:InventoryDevelopment_Semi,
        survey:InventoryTargetIndicator_Semi,
        survey:OrderCancellationChange_Semi .

survey:180nm_or_greater a owl:Class ;
    rdfs:label "180nm or greater" ;
    rdfs:subClassOf survey:InventoryDevelopment_Semi,
        survey:InventoryTargetIndicator_Semi,
        survey:OrderCancellationChange_Semi .

survey:28nm_to_less_than_45nm a owl:Class ;
