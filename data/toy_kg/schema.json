{
  "description": "Toy knowledge graph schema for supply chain and manufacturing QA. Use this to constrain query generation.",
  "classes": [
    "Product",
    "Supplier",
    "Material",
    "Yield",
    "Lot",
    "Tool",
    "Defect",
    "ProcessStep",
    "Fab",
    "CapacityConstraint",
    "Shipment",
    "Order",
    "Status",
    "Inventory"
  ],
  "predicates": [
    "SUPPLIES",
    "AFFECTS",
    "REQUIRES",
    "USED_IN",
    "PRODUCED_FOR",
    "PROCESSED_WITH",
    "HAS_DEFECT",
    "PRODUCES",
    "HAS_CONSTRAINT",
    "CONTAINS",
    "DEPENDS_ON",
    "HAS_STATUS",
    "STOCKS"
  ],
  "properties": [
    "name",
    "value",
    "lot_id",
    "tool_id",
    "defect_code",
    "severity",
    "fab_id",
    "constraint_type",
    "limit",
    "shipment_id",
    "order_id",
    "days_of_supply"
  ],
  "labels": {
    "Product": {
      "properties": ["name"],
      "domain": ["manufacturing"]
    },
    "Supplier": {
      "properties": ["name"],
      "domain": ["supply_chain"]
    },
    "Material": {
      "properties": ["name"],
      "domain": ["supply_chain", "manufacturing"]
    },
    "Yield": {
      "properties": ["value"],
      "domain": ["manufacturing"]
    },
    "Lot": {
      "properties": ["lot_id"],
      "domain": ["manufacturing"]
    },
    "Tool": {
      "properties": ["tool_id", "name"],
      "domain": ["manufacturing"]
    },
    "Defect": {
      "properties": ["defect_code", "severity"],
      "domain": ["manufacturing"]
    },
    "ProcessStep": {
      "properties": ["name"],
      "domain": ["manufacturing"]
    },
    "Fab": {
      "properties": ["fab_id", "name"],
      "domain": ["manufacturing"]
    },
    "CapacityConstraint": {
      "properties": ["constraint_type", "limit"],
      "domain": ["manufacturing"]
    },
    "Shipment": {
      "properties": ["shipment_id"],
      "domain": ["supply_chain"]
    },
    "Order": {
      "properties": ["order_id"],
      "domain": ["supply_chain"]
    },
    "Status": {
      "properties": ["name"],
      "domain": ["supply_chain"]
    },
    "Inventory": {
      "properties": ["days_of_supply"],
      "domain": ["supply_chain"]
    }
  },
  "relationships": [
    {
      "type": "SUPPLIES",
      "from": ["Supplier"],
      "to": ["Product", "Material"],
      "description": "Supplier provides Product or Material."
    },
    {
      "type": "AFFECTS",
      "from": ["Supplier"],
      "to": ["Yield"],
      "description": "Supplier impacts Yield."
    },
    {
      "type": "REQUIRES",
      "from": ["Product"],
      "to": ["ProcessStep"],
      "description": "Product requires a manufacturing process step."
    },
    {
      "type": "USED_IN",
      "from": ["Material"],
      "to": ["ProcessStep"],
      "description": "Material is used in a process step."
    },
    {
      "type": "PRODUCED_FOR",
      "from": ["Lot"],
      "to": ["Product"],
      "description": "Lot is produced for a product."
    },
    {
      "type": "PROCESSED_WITH",
      "from": ["Lot"],
      "to": ["Tool"],
      "description": "Lot processed with a tool."
    },
    {
      "type": "HAS_DEFECT",
      "from": ["Lot"],
      "to": ["Defect"],
      "description": "Lot has a defect."
    },
    {
      "type": "PRODUCES",
      "from": ["Fab"],
      "to": ["Product"],
      "description": "Fab produces product."
    },
    {
      "type": "HAS_CONSTRAINT",
      "from": ["Fab"],
      "to": ["CapacityConstraint"],
      "description": "Fab has capacity constraint."
    },
    {
      "type": "CONTAINS",
      "from": ["Order"],
      "to": ["Product"],
      "description": "Order contains product."
    },
    {
      "type": "DEPENDS_ON",
      "from": ["Order"],
      "to": ["Shipment"],
      "description": "Order depends on shipment."
    },
    {
      "type": "HAS_STATUS",
      "from": ["Shipment"],
      "to": ["Status"],
      "description": "Shipment has a status."
    },
    {
      "type": "STOCKS",
      "from": ["Inventory"],
      "to": ["Product"],
      "description": "Inventory stocks product."
    }
  ],
  "allowed_property_filters": {
    "Product": ["name"],
    "Supplier": ["name"],
    "Material": ["name"],
    "ProcessStep": ["name"],
    "Status": ["name"],
    "Yield": ["value"],
    "Inventory": ["days_of_supply"],
    "Lot": ["lot_id"],
    "Tool": ["tool_id", "name"],
    "Fab": ["fab_id", "name"],
    "Order": ["order_id"],
    "Shipment": ["shipment_id"],
    "Defect": ["defect_code", "severity"],
    "CapacityConstraint": ["constraint_type", "limit"]
  },
  "notes": [
    "Relationship direction is authoritative for query generation.",
    "All entity names in questions are placeholders and should match existing nodes."
  ]
}
