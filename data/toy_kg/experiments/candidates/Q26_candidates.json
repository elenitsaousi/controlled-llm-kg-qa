{
  "question_id": "Q26",
  "question": "Which fabs experience production bottlenecks?",
  "candidates": [
    {
      "id": "Q26_C1",
      "query": "MATCH (f:Fab)-[:HAS_CONSTRAINT]->(c:CapacityConstraint {constraint_type:'production_bottleneck'}) RETURN f.name"
    },
    {
      "id": "Q26_C2",
      "query": "MATCH (f:Fab)<-[:PRODUCES]-(p:Product)-[:HAS_CONSTRAINT]->(c:CapacityConstraint {constraint_type:'production_bottleneck'}) RETURN f.name"
    },
    {
      "id": "Q26_C3",
      "query": "MATCH (f:Fab)<-[:PRODUCES]-(l:Lot)-[:HAS_DEFECT]->(d:Defect), (l)-[:PROCESSED_WITH]->(t:Tool) WHERE d.severity='high' RETURN DISTINCT f.name"
    },
    {
      "id": "Q26_C4",
      "query": "MATCH (f:Fab)<-[:PRODUCES]-(p:Product)-[:DEPENDS_ON]->(s:Shipment)-[:HAS_STATUS {name:'delayed'}]->() RETURN f.name"
    },
    {
      "id": "Q26_C5",
      "query": "MATCH (f:Fab)<-[:PRODUCES]-(i:Inventory)-[:STOCKS]->(p:Product)-[:HAS_CONSTRAINT]->(c:CapacityConstraint {constraint_type:'production_bottleneck'}) RETURN f.name"
    }
  ]
}