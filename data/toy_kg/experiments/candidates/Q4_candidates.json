{
  "question_id": "Q4",
  "question": "Which suppliers provide a specific material?",
  "candidates": [
    {
      "id": "Q4_C1",
      "query": "MATCH (s:Supplier)-[:SUPPLIES]->(m:Material {name:'specific_material'}) RETURN s.name"
    },
    {
      "id": "Q4_C2",
      "query": "MATCH (s:Supplier)<-[:SUPPLIES]-(m:Material {name:'specific_material'}) RETURN s.name"
    },
    {
      "id": "Q4_C3",
      "query": "MATCH p=(s:Supplier)-[:SUPPLIES]->(m:Material {name:'specific_material'}) RETURN DISTINCT s.name"
    },
    {
      "id": "Q4_C4",
      "query": "MATCH (s:Supplier)-[:SUPPLIES]->(:Material {name:'specific_material'}) RETURN s.name"
    },
    {
      "id": "Q4_C5",
      "query": "MATCH (s:Supplier)<-[:SUPPLIES]-(m:Material {name:'specific_material'}) WITH s MATCH (s)-[r:SUPPLIES]->(m) RETURN DISTINCT s.name"
