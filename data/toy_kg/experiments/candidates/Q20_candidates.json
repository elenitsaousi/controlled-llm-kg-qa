{
  "question_id": "Q20",
  "question": "Which tools are associated with defects?",
  "candidates": [
    {
      "id": "Q20_C1",
      "query": "MATCH (l:Lot)-[:HAS_DEFECT]->(d:Defect)<-[:USED_IN]-(t:Tool) RETURN DISTINCT t.name"
    },
    {
      "id": "Q20_C2",
      "query": "MATCH (l:Lot)-[:HAS_DEFECT]->(d:Defect)<-[:PROCESSED_WITH]-(t:Tool) RETURN DISTINCT t.name"
    },
    {
      "id": "Q20_C3",
      "query": "MATCH (l:Lot)-[:HAS_DEFECT]->(d:Defect)<-[:USED_IN|PROCESSED_WITH]-(t:Tool) RETURN DISTINCT t.name"
    },
    {
      "id": "Q20_C4",
      "query": "MATCH (l:Lot)-[:HAS_DEFECT]->(d:Defect), (l)-[:PROCESSED_WITH]->(t:Tool) RETURN DISTINCT t.name"
    },
    {
      "id": "Q20_C5",
      "query": "MATCH (l:Lot)-[:HAS_DEFECT]->(d:Defect)<-[:USED_IN|PROCESSED_WITH]-(t:Tool) WHERE NOT (t)-[]->() RETURN DISTINCT t.name"
