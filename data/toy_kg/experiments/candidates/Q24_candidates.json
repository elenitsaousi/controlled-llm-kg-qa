{
  "question_id": "Q24",
  "question": "Which defects impact manufacturing yield?",
  "candidates": [
    {
      "id": "Q24_C1",
      "query": "MATCH (d:Defect)-[:AFFECTS]->(y:Yield) RETURN d.defect_code, y.value"
    },
    {
      "id": "Q24_C2",
      "query": "MATCH (d:Defect)-[r:AFFECTS]->(y:Yield) RETURN d.defect_code, r.type, y.value"
    },
    {
      "id": "Q24_C3",
      "query": "MATCH (d:Defect)<-[:AFFECTS]-(y:Yield) RETURN d.defect_code, y.severity, y.value"
    },
    {
      "id": "Q24_C4",
      "query": "MATCH (d:Defect)-[r:AFFECTS]->(y:Yield) WHERE r.type = 'manufacturing' RETURN d.defect_code, r.type, y.value"
    },
    {
      "id": "Q24_C5",
      "query": "MATCH (d:Defect)-[:AFFECTS]->(y:Yield) WITH d, COLLECT(DISTINCT y.value) AS yields RETURN d.defect_code, yields"
    }
  ]
}