{
  "question_id": "Q17",
  "question": "Which tools are used to process lots?",
  "candidates": [
    {
      "id": "Q17_C1",
      "query": "MATCH (l:Lot)-[:PROCESSED_WITH]->(t:Tool) RETURN t.name"
    },
    {
      "id": "Q17_C2",
      "query": "MATCH (l:Lot)-[:PROCESSED_WITH {name:'Tool'}]->(p:Product) RETURN DISTINCT p.name, t.name"
    },
    {
      "id": "Q17_C3",
      "query": "MATCH (l:Lot)-[r:PROCESSED_WITH]->(t:Tool) RETURN r.name, t.name"
    },
