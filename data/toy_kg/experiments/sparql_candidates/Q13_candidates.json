{
  "question_id": "Q13",
  "question": "Which orders are delayed due to shipment issues?",
  "candidates": [
    {
      "id": "Q13_C1",
      "query": "SELECT ?o WHERE { ?o a :Order . ?s a :Shipment . ?st a :Status . ?st :name ?st_name . ?o :DEPENDS_ON ?s . ?s :HAS_STATUS ?st . FILTER(?st_name = 'Delayed') }"
    },
    {
      "id": "Q13_C2",
      "query": "SELECT ?order WHERE { ?order a :Order . ?order :DEPENDS_ON ?shipment . ?shipment a :Shipment . ?shipment :HAS_STATUS 'delayed' }"
    },
    {
      "id": "Q13_C3",
      "query": "SELECT ?order WHERE { ?order a :Order . ?order :DEPENDS_ON ?shipment . ?shipment a :Shipment . ?shipment :HAS_STATUS 'delayed' . ?shipment :SHIPMENT_ISSUE 'true' }"
    },
    {
      "id": "Q13_C4",
      "query": "SELECT ?order WHERE { ?order a :Order . ?order :DEPENDS_ON ?shipment . ?shipment :a :Shipment . FILTER(?shipment :HAS_STATUS 'Delayed') . }"
    },
    {
      "id": "Q13_C5",
      "query": "SELECT ?order WHERE { ?order a :Order . ?order :CONTAINS ?product . ?shipment a :Shipment . ?shipment :HAS_STATUS :OnTime . FILTER(?order != ?shipment) . }"
    }
  ]
}
