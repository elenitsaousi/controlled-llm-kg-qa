    {
      "id": "Q30_C5",
      "query": "SELECT ?shipment WHERE { ?order a :Order . ?order :DEPENDS_ON ?shipment . ?shipment :HAS_DEFECT ?defect . ?defect :SEVERITY 'delay' . }"
    }
