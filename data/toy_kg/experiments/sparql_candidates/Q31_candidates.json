    {
      "id": "Q31_C4",
      "query": "SELECT ?supplier WHERE { ?supplier a :Supplier . ?supplier :PRODUCES ?product . ?product :HAS_CONSTRAINT ?constraint . ?constraint :severity 'LOW_YIELD' . }"
