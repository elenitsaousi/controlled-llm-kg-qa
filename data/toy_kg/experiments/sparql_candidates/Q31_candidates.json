{
  "question_id": "Q31",
  "question": "Which suppliers are associated with low yield?",
  "candidates": [
    {
      "id": "Q31_C1",
      "query": "SELECT ?s WHERE { ?s a :Supplier . ?y a :Yield . ?y :value ?y_value . ?s :AFFECTS ?y . FILTER(?y_value = 'low') }"
    },
    {
      "id": "Q31_C2",
      "query": "SELECT ?supplier WHERE { ?supplier a :Supplier . ?supplier :AFFECTS ?yield . ?yield a :Yield . FILTER(?yield :value < 0.5) . }"
    },
    {
      "id": "Q31_C3",
      "query": "SELECT ?supplier WHERE { ?supplier a :Supplier . ?supplier :PRODUCES ?product . ?product :AFFECTS ?yield . ?yield a :Yield . FILTER(?yield :value < 0.5) . }"
