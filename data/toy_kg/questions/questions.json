[
  {
    "id": "Q1",
    "question": "Which suppliers affect the production yield of product X?",
    "intent": "cross_domain_dependency",
    "entities": [
      "Product",
      "Supplier",
      "Yield"
    ],
    "gold_query": "MATCH (p:Product {name: 'X'})<-[:SUPPLIES]-(s:Supplier)-[:AFFECTS]->(y:Yield) RETURN s, y",
    "domain": [
      "supply_chain",
      "manufacturing"
    ],
    "difficulty": "medium",
    "expected_answer_type": "list_of_entities",
    "constraints": [
      "Must traverse SUPPLIES from Supplier to Product",
      "Must include AFFECTS relation to Yield"
    ]
  },
  {
    "id": "Q2",
    "question": "Which suppliers provide materials used in lithography for product X?",
    "intent": "material_supply_for_process",
    "entities": [
      "Supplier",
      "Material",
      "ProcessStep",
      "Product"
    ],
    "gold_query": "MATCH (s:Supplier)-[:SUPPLIES]->(m:Material)-[:USED_IN]->(ps:ProcessStep {name: 'Lithography'})<-[:REQUIRES]-(p:Product {name: 'X'}) RETURN s, m",
    "domain": [
      "supply_chain",
      "manufacturing"
    ],
    "difficulty": "hard",
    "expected_answer_type": "list_of_entities",
    "constraints": [
      "ProcessStep must be Lithography",
      "Path must include Supplier->Material->ProcessStep"
    ]
  },
  {
    "id": "Q3",
    "question": "Which manufacturing tools are linked to defects for product X?",
    "intent": "defect_traceability",
    "entities": [
      "Product",
      "Lot",
      "Tool",
      "Defect"
    ],
    "gold_query": "MATCH (p:Product {name: 'X'})<-[:PRODUCED_FOR]-(l:Lot)-[:PROCESSED_WITH]->(t:Tool), (l)-[:HAS_DEFECT]->(d:Defect) RETURN DISTINCT t, d",
    "domain": [
      "manufacturing"
    ],
    "difficulty": "hard",
    "expected_answer_type": "list_of_entities",
    "constraints": [
      "Must include Lot as bridge from Product to Tool",
      "Must include HAS_DEFECT relation"
    ]
  },
