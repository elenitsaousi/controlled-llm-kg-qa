  {
    "id": "Q11",
    "question": "Which suppliers are associated with supply delays?",
    "intent": "delay_analysis",
    "entities": [
      "Supplier",
      "Product",
      "Order",
      "Shipment",
      "Status"
    ],
    "gold_query": "MATCH (s:Supplier)-[:SUPPLIES]->(p:Product)<-[:CONTAINS]-(o:Order)-[:DEPENDS_ON]->(sh:Shipment)-[:HAS_STATUS]->(st:Status {name:'Delayed'}) RETURN s",
    "domain": [
      "supply_chain"
    ],
    "difficulty": "medium",
    "expected_answer_type": "list_of_entities",
    "constraints": [
      "Must traverse SUPPLIES from Supplier to Product",
      "Order must CONTAIN that Product",
      "Order must DEPEND_ON a Shipment",
      "Shipment must have Status 'Delayed'"
    ]
  },
